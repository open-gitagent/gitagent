{
  "name": "@open-gitagent/desktop",
  "version": "0.1.0",
  "description": "Cowork-style macOS desktop app for gitagent — local-folder sessions, model choice, streaming, plan approval.",
  "author": "shreyaskapale",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@open-gitagent/gitagent": "file:..",
